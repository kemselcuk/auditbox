<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.auditbox</groupId>
	<artifactId>auditbox</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>AuditBox</name>
	<description>AuditBox event history service</description>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<!-- Java 21 LTS build target: builds identically under JDK 21 and newer JDKs. -->
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Spring Boot 4 introduces a dedicated Flyway starter (renamed wiring vs 3.x). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring Boot 4 renamed the classic "web" starter to "webmvc". -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- PostgreSQL support artifact required by Flyway 10+. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- OpenAPI 3 documentation. springdoc-openapi v3.x is the line that supports
		     Spring Boot 4 (see https://springdoc.org). Version managed here because
		     Spring Boot does not manage springdoc. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers 2.x artifact names (renamed from "postgresql"/"junit-jupiter"). -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- SBOM (Milestone 9.6): a CycloneDX BOM over all direct and transitive
			     dependencies is written to target/bom.json on every package (and therefore
			     every ./mvnw verify and CI run); the CI workflow uploads it as an artifact.
			     2.9.x is the newest released line (uses CycloneDX schema v1.6). -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>2.9.3</version>
				<configuration>
					<!-- JSON only: the artifact consumers read bom.json; no need for the XML twin. -->
					<outputFormat>json</outputFormat>
					<projectType>application</projectType>
				</configuration>
				<executions>
					<execution>
						<id>make-sbom</id>
						<phase>package</phase>
						<goals>
							<goal>makeBom</goal>
						</goals>
						<configuration>
							<!-- Review F3: the Spring Boot parent already binds its default
							     makeAggregateBom execution (generate-resources), which attaches the
							     SBOM artifact. Attaching this one too replaced it and logged a
							     warning on every build; this execution only needs to write
							     target/bom.json for CI. -->
							<skipAttach>true</skipAttach>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Milestone 9.7: Playwright end-to-end suite for the static demo page, fully
	     opt-in. Everything E2E-related lives ONLY inside this profile: the Playwright
	     dependency (classpath), the src/e2e/java test source root (added via
	     build-helper-maven-plugin; the default build never compiles it), and a Surefire
	     include filter so `./mvnw -B -Pe2e verify` executes only the E2E tests while the
	     default `./mvnw verify` keeps running the existing suite unchanged (227 tests,
	     no browser download, no extra artifacts). -->
	<profiles>
		<profile>
			<id>e2e</id>
			<!-- Playwright for Java. 1.63.0 is the newest stable release per the
			     artifact's maven-metadata.xml on Maven Central (fetched live). -->
			<dependencies>
				<dependency>
					<groupId>com.microsoft.playwright</groupId>
					<artifactId>playwright</artifactId>
					<version>1.63.0</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<!-- Adds src/e2e/java as an additional *test* source root. Only
					     active under -Pe2e, so the default build never sees (or
					     compiles) the E2E sources. For the same reason (profile-only
					     wiring) the Spring Boot parent's version management does not
					     pin build-helper-maven-plugin: 3.6.2 is the newest release
					     per Maven Central. -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<version>3.6.2</version>
						<executions>
							<execution>
								<id>add-e2e-test-source</id>
								<phase>generate-test-sources</phase>
								<goals>
									<goal>add-test-source</goal>
								</goals>
								<configuration>
									<sources>
										<source>src/e2e/java</source>
									</sources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!-- Under this profile Surefire runs only the E2E tests; the
					     existing unit/integration suite keeps its own run under the
					     default build (which has no include filter from here). -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<includes>
								<include>**/*E2ETest.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
