# AuditBox environment example.
# Copy to .env to override defaults used by docker compose and the app's local profile.
# Never commit .env or real secrets.

# --- PostgreSQL (docker compose "db" service and the app's local profile) ---
# Safe local defaults; change password for anything non-local.
DB_NAME=auditbox
DB_USER=auditbox
DB_PASSWORD=auditbox
DB_PORT=5432
# Host used by the app when running outside docker (defaults to localhost);
# the compose service always reaches the database internally.
# DB_HOST=localhost

# --- Application ---
# Static API key placeholder. Not enforced yet; Stage 5 adds X-API-Key authentication
# (missing key fails fast in the "prod" profile).
API_KEY=change-me-locally
