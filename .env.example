# AuditBox environment example.
# Copy to .env for docker compose only: compose reads .env automatically.
# A host-run app (./mvnw spring-boot:run) does NOT read .env — pass the same values
# as environment variables on the command line (e.g. DB_PORT=5433 ...) instead.
# Never commit .env or real secrets.

# --- PostgreSQL (docker compose "db" service and the app's local profile) ---
# Safe local defaults; change password for anything non-local.
DB_NAME=auditbox
DB_USER=auditbox
DB_PASSWORD=auditbox
DB_PORT=5432
# Host used by the app when running outside docker (defaults to localhost);
# the compose service always reaches the database internally.
# DB_HOST=localhost

# --- Application ---
# API key registry (X-API-Key authentication, D18): comma-separated source:sha256hex
# entries, where sha256hex is the SHA-256 digest of the plaintext key — the server never
# stores plaintext keys. Generate a digest with:
#   printf %s 'the-key' | sha256sum
# The app binds the value to auditbox.security.api-keys: the default below is the digest
# of the documented local development key 'local-dev-key' (local/dev profiles), and the
# prod profile fails fast at startup when this variable is blank or parses to zero entries.
API_KEYS=local-dev:ed5a18fb8f807f996d649e379d3f35f39c543a91bdbf88c492f2ebd10d4df86c

# --- Retention and partition maintenance (M11.2/D22) ---
# The job runs once at application startup and then daily at 03:30 server time: it
# creates the missing monthly partitions of the lookahead window (current month
# RETENTION_LOOKAHEAD_MONTHS months ahead), drops monthly partitions whose ENTIRE range
# is older than RETENTION_MONTHS (dropping a partition deletes its rows by design — this
# IS the retention policy) and deletes older rows from the DEFAULT partition in batches
# of RETENTION_DEFAULT_DELETE_BATCH_SIZE, at most RETENTION_MAX_BATCHES_PER_RUN batches
# per pass (this bounds the expired-rows DELETE only; the F2 move is atomic). All time math is UTC. False disables the job entirely (no DDL, no deletes,
# no counter increments). Invalid values abort startup when the job is enabled.
# Single instance note: every replica would run this job; stagger RETENTION_CRON or set
# RETENTION_ENABLED=false on extra replicas.
RETENTION_ENABLED=true
RETENTION_MONTHS=24
RETENTION_LOOKAHEAD_MONTHS=3
RETENTION_DEFAULT_DELETE_BATCH_SIZE=1000
RETENTION_MAX_BATCHES_PER_RUN=10
RETENTION_CRON=0 30 3 * * *

# --- Rate limiting (D19): in-memory per-source token bucket, single instance only ---
# Master switch; false disables limiting (and the auditbox.rate.limited counter) entirely.
RATE_LIMIT_ENABLED=true
# Capacity of every source's bucket, in requests per minute; refill is continuous at
# limit/60 per second. Must be >= 1 when RATE_LIMIT_ENABLED=true — a smaller value aborts
# startup. See README "Rate limiting" for the 429/Retry-After behavior.
RATE_LIMIT_REQUESTS_PER_MINUTE=300
